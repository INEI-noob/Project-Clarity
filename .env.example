# Copy this file to .env.local and fill in your EmailJS credentials.
# https://dashboard.emailjs.com
#
# Create ONE EmailJS template with these placeholders ({{ to_name }}, {{ to_email }}, {{ message }}):
#   Subject:  New message from Project Clarity
#   Body:     {{ to_name }} wrote: {{ message }}
# The contact form, guide feedback, and newsletter all send the same three params,
# so a single template covers all of them.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The Pulse (community wall) needs Supabase. When these are empty, the site
# shows the "coming soon" fallback instead of the live feed.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Expected Supabase schema (created via the Supabase dashboard / SQL editor):
#   table: pulses
#     id            uuid pk default gen_random_uuid()
#     content       text not null
#     mood          text            -- 'rant' | 'celebrate' | 'question' | 'support'
#     is_anonymous  boolean default true
#     user_name     text
#     reactions     jsonb default '{"hug":0,"same":0,"love":0,"here":0}'
#     reply_count   integer default 0
#     delete_token  text            -- random UUID; only author can edit/delete
#     is_deleted    boolean default false
#     created_at    timestamptz default now()
#
#   table: comments
#     id            uuid pk default gen_random_uuid()
#     pulse_id      uuid references pulses(id) on delete cascade
#     parent_id     uuid            -- replies to a comment; null = top level
#     content       text not null
#     is_anonymous  boolean default true
#     user_name     text
#     reactions     jsonb default '{"heart":0,"agree":0}'
#     is_deleted    boolean default false
#     created_at    timestamptz default now()
#
# Enable Realtime for both tables (Supabase dashboard -> Database -> Replication)
# so the live feed updates in-place.